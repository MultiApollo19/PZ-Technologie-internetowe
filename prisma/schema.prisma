generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model missions {
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  name              String?
  description       String?
  image             String?
  id                String   @id
  description_short String?
}
